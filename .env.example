# Frontend-safe public configuration (VITE_ values are exposed in browser)
VITE_BRAND_NAME=AP Creative Studio
VITE_WHATSAPP_NUMBER=910000000000
VITE_CONTACT_EMAIL=hello@example.com
# Leave empty or set to your API URL. On pure Vercel static deploy the order form falls back to WhatsApp.
VITE_API_BASE_URL=

# Server-only configuration (used when running the Express server elsewhere)
PORT=4000
CLIENT_ORIGIN=https://your-vercel-app.vercel.app
DATABASE_PATH=./server/data/orders.sqlite
ADMIN_PASSWORD=change-this-to-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
